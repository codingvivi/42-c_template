{% if project_type == 'ConsoleApp' -%}
NAME = {{project_name}}
{% else -%}
NAME = {{project_name}}.a
{% endif -%}
TEST_NAME = runner

.DEFAULT_GOAL := all

CC         = cc
CFLAGS     = -Wall -Wextra -Werror -fPIE
TEST_CFLAGS = $(CFLAGS)
INCLUDES   = -I./src -I./include{% if use_libft %} -I$(LIBFT_INCLUDE_DIR){% endif %}

{% if project_type != 'ConsoleApp' -%}
AR = ar -rcs

{% endif -%}
RM = rm -rf

RELEASE_TAG  ?=
RELEASE_NAME = {{project_name}}_turnin_$(RELEASE_TAG).tar.gz
RELEASE_BASE = $(basename $(basename $(RELEASE_NAME)))


{% if project_type == 'ConsoleApp' -%}
FILES = main
{% else -%}
FILES = {{project_name}}
{% endif %}

# code
SRC_DIR     := src
INCLUDE_DIR := include
TEST_SRC_DIR := test

# build output
BUILD_DIR   := build
OBJ_DIR     := $(BUILD_DIR)/obj
SRC_OBJ_DIR := $(OBJ_DIR)/src
TEST_OBJ_DIR := $(OBJ_DIR)/test

# build results
BIN_DIR      := $(BUILD_DIR)/bin
SRC_BIN_DIR  := $(BIN_DIR)/src
TEST_BIN_DIR := $(BIN_DIR)/test
{% if project_type != 'ConsoleApp' -%}
LIB_DIR      := $(BUILD_DIR)/lib
{% endif -%}

{% if use_libft -%}
# external libraries
EXTERNAL_DIR     := external
LIBFT_DIR        := $(EXTERNAL_DIR)/lib/libft
LIBFT_INCLUDE_DIR := $(LIBFT_DIR)/include
LIBFT            := $(LIBFT_DIR)/build/lib/libft.a

{% endif -%}
# dist
DIST_DIR := $(BUILD_DIR)/dist

{% if project_type == 'ConsoleApp' -%}
HEADER_FILES =
{% else -%}
HEADER_FILES = {{project_name}}
{% endif %}
TEST_FILES = main

SRCS = $(FILES:%=$(SRC_DIR)/%.c)
HDRS = $(HEADER_FILES:%=$(INCLUDE_DIR)/%.h)
OBJS = $(FILES:%=$(SRC_OBJ_DIR)/%.o)
{% if project_type != 'ConsoleApp' -%}
LIB  = $(LIB_DIR)/$(NAME)
{% endif -%}

TEST_SRCS = $(TEST_FILES:%=$(TEST_SRC_DIR)/%.c)
TEST_OBJS = $(TEST_FILES:%=$(TEST_OBJ_DIR)/%.o)

{% if flat_repo -%}
DIST_FILES = {% if submit_makefile %}Makefile {% endif %}README.md $(SRCS) $(HDRS)
{% else -%}
DIST_FILES = {% if submit_makefile %}Makefile {% endif %}README.md $(FILES:%=src/%.c) $(HEADER_FILES:%=include/%.h)
{% endif -%}

# build
{% if project_type == 'ConsoleApp' -%}
all: {% if flat_repo or use_libft %}init {% endif %}$(NAME){% if use_libft %} | $(LIBFT_DIR){% endif %}

{% else -%}
all: {% if flat_repo or use_libft %}init {% endif %}$(LIB){% if use_libft %} | $(LIBFT_DIR){% endif %}

{% endif -%}
{% if copy_build_to_root -%}
ifeq ($(TURNIN_RUN),true)
{% if project_type == 'ConsoleApp' -%}
	cp $(SRC_BIN_DIR)/$(NAME) $(NAME)
{% else -%}
	cp $(LIB) $(NAME)
	cp $(HDRS) .
{% endif -%}
endif
{% endif -%}

{% if project_type != 'ConsoleApp' -%}
$(NAME): all

{% endif -%}
{% if project_type == 'ConsoleApp' -%}
# link objects into executable
$(NAME): $(OBJS){% if use_libft %} $(LIBFT){% endif %} | $(SRC_BIN_DIR)
	$(CC) $(CFLAGS) $(INCLUDES) $(OBJS){% if use_libft %} $(LIBFT){% endif %} -o $(SRC_BIN_DIR)/$(NAME)
{% else -%}
# archive objects into static library
$(LIB): $(OBJS){% if use_libft %} $(LIBFT){% endif %} | $(LIB_DIR)
	$(AR) $@ $(OBJS)
{% endif %}
# compile source files to objects
$(SRC_OBJ_DIR)/%.o: $(SRC_DIR)/%.c | $(SRC_OBJ_DIR)
	$(CC) $(CFLAGS) $(INCLUDES) -c $< -o $@

{% if flat_repo -%}
# move flat source files into src/ if they exist in root
$(SRC_DIR)/%.c: %.c | $(SRC_DIR)
	mv $< $@

# move flat headers into include/ if they exist in root
$(INCLUDE_DIR)/%.h: %.h | $(INCLUDE_DIR)
	mv $< $@
{% endif -%}

{% if use_libft -%}
# move libft into external/lib/ if it exists in root
$(LIBFT_DIR): libft | $(EXTERNAL_DIR)
	mkdir -p $(EXTERNAL_DIR)/lib
	mv $< $@

# build libft
$(LIBFT): | $(LIBFT_DIR)
	$(MAKE) -C $(LIBFT_DIR)

{% endif -%}
# create source obj directory
$(SRC_OBJ_DIR): | $(BUILD_DIR)
	mkdir -p $(SRC_OBJ_DIR)

# create test obj directory
$(TEST_OBJ_DIR): | $(BUILD_DIR)
	mkdir -p $(TEST_OBJ_DIR)

# create src bin directory
$(SRC_BIN_DIR): | $(BUILD_DIR)
	mkdir -p $(SRC_BIN_DIR)

# create test bin directory
$(TEST_BIN_DIR): | $(BUILD_DIR)
	mkdir -p $(TEST_BIN_DIR)

{% if project_type != 'ConsoleApp' -%}
# create lib directory
$(LIB_DIR): | $(BUILD_DIR)
	mkdir -p $(LIB_DIR)
{% endif -%}


# create build directory
$(BUILD_DIR):
	mkdir -p $(BUILD_DIR)

# create src directory
$(SRC_DIR):
	mkdir -p $(SRC_DIR)

# create include directory
$(INCLUDE_DIR):
	mkdir -p $(INCLUDE_DIR)

{% if use_libft -%}
# create external directory
$(EXTERNAL_DIR):
	mkdir -p $(EXTERNAL_DIR)
{% endif -%}

# create dist directory
$(DIST_DIR): | $(BUILD_DIR)
	mkdir -p $(DIST_DIR)

{% if flat_repo or use_libft -%}
# initialize project structure from flat layout
init: {% if flat_repo %}$(SRCS) $(HDRS) {% endif %}{% if use_libft %}$(LIBFT_DIR){% endif %}

{% endif -%}
# create flat distribution environment for turnin
stage: | $(DIST_DIR)
	$(RM) $(DIST_DIR)/$(RELEASE_BASE)
	mkdir -p $(DIST_DIR)/$(RELEASE_BASE)
{% if flat_repo -%}
	cp $(DIST_FILES) $(DIST_DIR)/$(RELEASE_BASE)/
{% else -%}
	cp --parents $(DIST_FILES) $(DIST_DIR)/$(RELEASE_BASE)/
{% endif -%}
{% if submit_makefile and copy_build_to_root -%}
	sed -i '1i TURNIN_RUN = true' $(DIST_DIR)/$(RELEASE_BASE)/Makefile
{% endif -%}
{% if use_libft -%}
{% if flat_repo -%}
	cp -r $(LIBFT_DIR) $(DIST_DIR)/$(RELEASE_BASE)/libft
{% else -%}
	mkdir -p $(DIST_DIR)/$(RELEASE_BASE)/external
	cp -r $(LIBFT_DIR) $(DIST_DIR)/$(RELEASE_BASE)/external/libft
{% endif -%}
{% endif -%}

# create a distribution tarball with the submission files
dist: stage
	tar -czf $(DIST_DIR)/$(RELEASE_NAME) -C $(DIST_DIR) $(RELEASE_BASE)

# build and run tests
test: $(TEST_NAME)

# link test runner
{% if project_type == 'ConsoleApp' -%}
$(TEST_NAME): $(NAME) $(TEST_OBJS) | $(TEST_BIN_DIR)
	$(CC) $(CFLAGS) $(TEST_OBJS) -o $(TEST_BIN_DIR)/$(TEST_NAME)
{% else -%}
$(TEST_NAME): $(LIB) $(TEST_OBJS) | $(TEST_BIN_DIR)
	$(CC) $(CFLAGS) $(TEST_OBJS) $(LIB) -o $(TEST_BIN_DIR)/$(TEST_NAME)
{% endif %}
# compile test files to objects
$(TEST_OBJ_DIR)/%.o: $(TEST_SRC_DIR)/%.c | $(TEST_OBJ_DIR)
	$(CC) $(TEST_CFLAGS) $(INCLUDES) -c $< -o $@

# remove object files
clean:
	$(RM) $(OBJ_DIR)

# remove all build artifacts
hclean: clean
{% if project_type == 'ConsoleApp' -%}
	$(RM) $(SRC_BIN_DIR)/$(NAME) $(TEST_BIN_DIR)/$(TEST_NAME)
{% else -%}
	$(RM) $(LIB) $(TEST_BIN_DIR)/$(TEST_NAME)
{% endif -%}
{% if use_libft -%}
	$(MAKE) -C $(LIBFT_DIR) hclean
{% endif -%}
{% if copy_build_to_root -%}
	$(RM) $(NAME)
{% endif -%}
	$(RM) $(DIST_DIR)/$(RELEASE_BASE)

{% if flat_repo or use_libft -%}
# flatten back to root (undo init)
fclean: hclean
{% if flat_repo -%}
	-mv $(SRC_DIR)/*.c .
	-mv $(INCLUDE_DIR)/*.h .
{% endif -%}
{% if use_libft -%}
	-mv $(LIBFT_DIR) libft
{% endif -%}
ifeq ($(TURNIN_RUN),true)
{% if flat_repo -%}
	-rmdir $(SRC_DIR) $(INCLUDE_DIR) 2>/dev/null; true
{% endif -%}
{% if use_libft -%}
	-$(RM) $(EXTERNAL_DIR)
{% endif -%}
endif
{% else -%}
fclean: hclean
{% endif -%}

# full rebuild
re: hclean all

{% if flat_repo or use_libft -%}
.PHONY: all init stage dist test clean hclean fclean re
{% else -%}
.PHONY: all stage dist test clean hclean fclean re
{% endif -%}
